# Copy this file to .env and adjust the values. Never commit .env.

# Base URL of the FHIR R4 server the pipeline validates against and uploads to.
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# Optional bearer token. The public HAPI test server needs no authentication,
# so leave it empty unless you point the pipeline at a protected server.
FHIR_AUTH_TOKEN=

# Input CSV exported from the legacy clinical system.
LEGACY_CSV_PATH=data/legacy-export.csv

# Directory where the pipeline writes its report.
OUTPUT_DIR=out

# Timeout applied to every HTTP request against the FHIR server, in milliseconds.
REQUEST_TIMEOUT_MS=30000

# When true, the pipeline parses, maps and validates but uploads nothing.
DRY_RUN=false
