{
  "name": "fhir-bridge",
  "version": "0.1.0",
  "description": "Converts a legacy clinical CSV export into validated HL7 FHIR R4 resources",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/fhir": "^0.0.42",
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
